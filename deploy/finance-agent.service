[Unit]
Description=Finance Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=finance-agent
Group=finance-agent
WorkingDirectory=/opt/finance-agent/app
Environment=NODE_ENV=production
Environment=HOME=/var/lib/finance-agent
Environment=PORT=4317
Environment=FINANCE_PRIVATE=/var/lib/finance-agent
Environment=FINANCE_DB=/var/lib/finance-agent/finance.sqlite
ExecStart=@@NODE@@ server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/finance-agent

[Install]
WantedBy=multi-user.target
